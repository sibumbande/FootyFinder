DATABASE_URL="postgresql://postgres:postgres@localhost:5432/footy_finder?schema=public"
PORT=3000
JWT_SECRET=replace-this-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=604800
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
NODE_ENV=development
TRUST_PROXY_HOPS=0
# Optional UTC timestamp for a short migration window accepting pre-session JWTs.
# LEGACY_JWT_GRACE_UNTIL=2026-09-01T00:00:00.000Z
RATE_LIMIT_AUTH_PER_15_MINUTES=20
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_COSTLY_MUTATIONS_PER_MINUTE=20
RATE_LIMIT_PUBLIC_PREVIEWS_PER_MINUTE=120
# Use a unique secret of at least 32 characters; required in production.
ADMIN_MFA_ENCRYPTION_KEY=replace-this-with-an-independent-mfa-key
ADMIN_MFA_MAX_AGE_MINUTES=720
# Development/test only. Production configuration rejects true.
ADMIN_TEST_DATA_ENABLED=false
DURABLE_JOB_POLL_INTERVAL_MS=5000
DURABLE_JOB_LOCK_TIMEOUT_SECONDS=300
BOOKING_FUNDING_MINUTES=15
POST_MATCH_CHAT_DURATION_MINUTES=25
PUBLIC_API_URL=http://localhost:3000
TEAM_UPLOAD_DIR=uploads/teams
PLAYER_UPLOAD_DIR=uploads/players
# Public venue photos. Local disk is wiped on most hosts (e.g. Render) on deploy: use R2/S3 before launch.
VENUE_UPLOAD_DIR=uploads/venues
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@footyfinder.test
# POSTMARK_SERVER_TOKEN=replace-in-production

# Gate 6 payments (DEC-011, DEC-021 match tickets). 'demo' confirms a ticket payment instantly and only works in
# development/test.
# Production must use 'paystack' with live keys; development/test accept only sk_test_/pk_test_ keys.
# Never commit real keys. Platform Operations owns production credentials.
PAYMENT_PROVIDER=demo
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# PAYSTACK_BASE_URL=https://api.paystack.co
