generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchFormat {
  FIVE_A_SIDE
  SEVEN_A_SIDE
  ELEVEN_A_SIDE
}

enum MatchVisibility {
  PUBLIC
  PRIVATE
}

enum MatchRule {
  GOALKEEPERS_SWAP_AFTER_EVERY_GOAL
}

enum MatchMode {
  QUICK_GAME
  TEAM_MATCH
}

enum MatchStatus {
  DRAFT
  OPEN
  READY
  IN_PROGRESS
  AWAITING_RESULT
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  JOINED
  LEFT
  REMOVED
}

enum TeamSide {
  HOME
  AWAY
}

enum TeamMatchAvailabilityStatus {
  AVAILABLE
  MAYBE
  UNAVAILABLE
  NO_RESPONSE
}

enum TeamMatchSelectionStatus {
  INVITED
  SELECTED_STARTER
  SELECTED_SUBSTITUTE
  OPEN_SLOT_CLAIMED
  DECLINED
  REMOVED
}

enum FootballPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum DominantFoot {
  LEFT
  RIGHT
  BOTH
}

enum WalletTransactionType {
  DEPOSIT
  MATCH_CREATE
  MATCH_JOIN
  DEPOSIT_CREDIT
  MATCH_ENTRY_DEBIT
  MATCH_CANCELLATION_CREDIT
  PLAYER_CANCELLATION_FULL_CREDIT
  PLAYER_CANCELLATION_PARTIAL_CREDIT
  REPLACEMENT_CREDIT
  FIELD_BOOKING_DEBIT
  TOP_UP_REFUND_DEBIT
  TOP_UP_REFUND_RESTORE_CREDIT
  CHARGEBACK_DEBIT
  CHARGEBACK_REVERSAL_CREDIT
  TEAM_CONTRIBUTION_DEBIT
  TEAM_CONTRIBUTION_REFUND_CREDIT
}

/// Gate 7 / TKT-701: Team Wallet ledger kinds (DEC-014, DEC-019).
enum TeamWalletTransactionType {
  CONTRIBUTION_CREDIT
  CONTRIBUTION_REFUND_DEBIT
  CLOSURE_REFUND_DEBIT
  TEAM_MATCH_FEE_DEBIT
}

enum TeamWalletHoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
}

enum WalletTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  ERROR
}

enum WalletHoldStatus {
  ACTIVE
  CAPTURED
  RELEASED
  EXPIRED
}

enum VenueBeneficiaryStatus {
  PENDING_APPROVAL
  APPROVED
  RETIRED
}

enum VenuePayableStatus {
  DUE
  IN_BATCH
  PAID
  VOID
}

enum VenueSettlementBatchStatus {
  PREPARED
  APPROVED
  PAID
  CANCELLED
}

enum ProviderRefundStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  RESTORED_TO_WALLET
}

enum ProviderDisputeStatus {
  OPEN
  WON
  LOST
}

enum ProviderPaymentStatus {
  INITIALIZED
  SUCCEEDED
  FAILED
  REVIEW
}

enum DurableJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum FieldReservationSource {
  ADMIN_LOADED
  PLAYER_BOOKING
}

enum FieldReservationStatus {
  FUNDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum FundingObligationStatus {
  PENDING
  FUNDED
  CAPTURED
  RELEASED
}

enum FundingContributionStatus {
  HELD
  CAPTURED
  RELEASED
}

enum MatchPaymentStatus {
  SUCCEEDED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TeamRole {
  OWNER
  CAPTAIN
  MEMBER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum PlatformRole {
  USER
  ADMIN
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum CitySupportStatus {
  ACTIVE
  WAITLIST
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  PARTICIPATION
  CODE_OF_CONDUCT
  COMPANY_DISCLOSURE
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum VerificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum ManagedFieldStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum VenuePublicationStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  DEACTIVATED
}

enum SupportTicketCategory {
  GENERAL
  ACCOUNT
  MATCH
  TEAM
  PAYMENT
  SAFETY
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageAuthorRole {
  USER
  ADMIN
}

enum ModerationReportTargetType {
  USER
  DIRECT_MESSAGE
  LOBBY_MESSAGE
  TEAM
  MATCH
}

enum ModerationReportReason {
  HARASSMENT
  ABUSE
  CHEATING
  SPAM
  IMPERSONATION
  SAFETY
  OTHER
}

enum ModerationReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AccountEnforcementType {
  SUSPENSION
  BAN
}

enum AccountEnforcementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum DisputeType {
  MATCH_RESULT
  FIELD_BOOKING
}

enum DisputeReason {
  INCORRECT_SCORE
  INCORRECT_SCORERS
  FIELD_UNAVAILABLE
  FIELD_QUALITY
  BOOKING_SERVICE
  PAYMENT
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum DisputeResolutionOutcome {
  RESULT_CONFIRMED
  RESULT_CORRECTED
  BOOKING_UPHELD
  BOOKING_REJECTED
}

enum ResultRevisionReason {
  INITIAL_SUBMISSION
  ADMIN_CORRECTION
}

enum ResultOutcomeType {
  PLAYED
  FORFEIT
}

enum NotificationType {
  INFO
  DIRECT_MESSAGE
  MATCH_INVITATION
  DEPOSIT_SUCCEEDED
  MATCH_JOINED
  PLAYER_CANCELLED
  REPLACEMENT_FOUND
  WALLET_CREDIT
  MATCH_CANCELLED
  MATCH_STARTED
  RESULT_SUBMITTED
  TEAM_MEMBER_JOINED
  TEAM_UPDATED
  TEAM_MATCH_AVAILABILITY_REQUESTED
  TEAM_MATCH_SELECTION_UPDATED
  TEAM_MATCH_POSITION_OPENED
  TEAM_MATCH_POSITION_CLAIMED
  TEAM_MATCH_LINEUP_FINALIZED
  SUPPORT_REPLY
  BOOKING_CONFIRMED
  BOOKING_EXPIRED
  DISPUTE_RESOLVED
  MATCH_POSITION_CHANGED
  MATCH_CONFIRMED
  MATCH_FILL_REMINDER
  WALLET_DEBIT
}

model User {
  id                        String                    @id @default(uuid()) @db.Uuid
  email                     String                    @unique
  username                  String                    @unique
  passwordHash              String
  emailVerifiedAt           DateTime?
  emailVerificationRequired Boolean                   @default(true)
  onboardingCompletedAt     DateTime?
  passwordChangedAt         DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  profile                   PlayerProfile?
  walletAccount             WalletAccount?
  createdMatches            Match[]                   @relation("MatchCreator")
  participations            MatchParticipant[]
  lobbyMessages             LobbyMessage[]            @relation("LobbyMessageSender")
  submittedResults          MatchResult[]             @relation("ResultSubmitter")
  conversationMemberships   ConversationParticipant[]
  directMessages            DirectMessage[]           @relation("DirectMessageSender")
  notifications             Notification[]
  ownedTeams                Team[]                    @relation("TeamOwner")
  teamMemberships           TeamMembership[]
  createdTeamInvites        TeamInvite[]              @relation("TeamInviteCreator")
  organisedMatchTeams       MatchTeam[]               @relation("MatchTeamOrganiser")
  teamMatchAvailabilities   TeamMatchAvailability[]
  teamMatchSelections       TeamMatchSelection[]      @relation("TeamMatchSelectedUser")
  madeMatchSelections       TeamMatchSelection[]      @relation("TeamMatchSelectionSelector")
  accountStatus             AccountStatus             @default(ACTIVE)
  platformRole              PlatformRole              @default(USER)
  authSessions              AuthSession[]
  adminMfaCredential        AdminMfaCredential?
  adminAuditActions         AdminAuditLog[]           @relation("AdminAuditActor")
  createdSupportTickets     SupportTicket[]           @relation("SupportTicketCreator")
  assignedSupportTickets    SupportTicket[]           @relation("SupportTicketAssignee")
  supportMessages           SupportTicketMessage[]
  createdTestDataBatches    TestDataBatch[]           @relation("TestDataBatchCreator")
  testDataBatchId           String?                   @db.Uuid
  testDataBatch             TestDataBatch?            @relation(fields: [testDataBatchId], references: [id], onDelete: Restrict)
  isTestAccount             Boolean                   @default(false)
  fundingContributions      FundingContribution[]
  moderationReports         ModerationReport[]        @relation("ModerationReporter")
  assignedReports           ModerationReport[]        @relation("ModerationReportAssignee")
  accountEnforcements       AccountEnforcement[]      @relation("EnforcedUser")
  createdEnforcements       AccountEnforcement[]      @relation("EnforcementCreator")
  revokedEnforcements       AccountEnforcement[]      @relation("EnforcementRevoker")
  openedDisputes            Dispute[]                 @relation("DisputeOpener")
  assignedDisputes          Dispute[]                 @relation("DisputeAssignee")
  createdResultRevisions    MatchResultRevision[]     @relation("ResultRevisionCreator")
  verificationTokens        VerificationToken[]
  legalAcceptances          LegalAcceptance[]
  cityInterests             CityInterest[]
  moderatedPlayerPhotos     PlayerPhoto[]             @relation("PlayerPhotoModerator")
  submittedVenues           ManagedVenue[]            @relation("VenueSubmitter")
  approvedVenues            ManagedVenue[]            @relation("VenueApprover")
  deactivatedVenues         ManagedVenue[]            @relation("VenueDeactivator")
  providerPayments          ProviderPayment[]
  initiatedRefunds          ProviderRefund[]          @relation("RefundInitiator")
  linkedBeneficiaries       VenueBeneficiary[]        @relation("BeneficiaryLinkedUser")
  createdBeneficiaries      VenueBeneficiary[]        @relation("BeneficiaryCreator")
  approvedBeneficiaries     VenueBeneficiary[]        @relation("BeneficiaryApprover")
  payableAdjustments        VenuePayableAdjustment[]
  preparedSettlements       VenueSettlementBatch[]    @relation("SettlementPreparer")
  approvedSettlements       VenueSettlementBatch[]    @relation("SettlementApprover")
  paidSettlements           VenueSettlementBatch[]    @relation("SettlementPayer")
  cancelledSettlements      VenueSettlementBatch[]    @relation("SettlementCanceller")
  restoredRefunds           ProviderRefund[]          @relation("RefundRestorer")
  teamWalletActions         TeamWalletTransaction[]   @relation("TeamWalletActor")
  teamWalletContributions   TeamWalletTransaction[]   @relation("TeamWalletContributor")
  teamWalletHoldsCreated    TeamWalletHold[]          @relation("TeamWalletHoldCreator")

  @@index([isTestAccount, testDataBatchId])
}

model AuthSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @db.Uuid
  expiresAt       DateTime
  revokedAt       DateTime?
  lastSeenAt      DateTime  @default(now())
  userAgentHash   String?
  ipHash          String?
  createdAt       DateTime  @default(now())
  adminVerifiedAt DateTime?
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model AdminMfaCredential {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @db.Uuid
  encryptedSecret String
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model ModerationReport {
  id                  String                     @id @default(uuid()) @db.Uuid
  reporterUserId      String                     @db.Uuid
  assignedAdminUserId String?                    @db.Uuid
  targetType          ModerationReportTargetType
  targetId            String                     @db.Uuid
  reason              ModerationReportReason
  details             String?
  evidenceSnapshot    Json
  status              ModerationReportStatus     @default(OPEN)
  resolutionSummary   String?
  resolvedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  reporter            User                       @relation("ModerationReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  assignedAdmin       User?                      @relation("ModerationReportAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([assignedAdminUserId, status, createdAt])
}

model AccountEnforcement {
  id                   String                   @id @default(uuid()) @db.Uuid
  userId               String                   @db.Uuid
  type                 AccountEnforcementType
  status               AccountEnforcementStatus @default(ACTIVE)
  publicReason         String
  internalNote         String?
  startsAt             DateTime                 @default(now())
  endsAt               DateTime?
  revokedAt            DateTime?
  createdByAdminUserId String                   @db.Uuid
  revokedByAdminUserId String?                  @db.Uuid
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  user                 User                     @relation("EnforcedUser", fields: [userId], references: [id], onDelete: Restrict)
  createdByAdmin       User                     @relation("EnforcementCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)
  revokedByAdmin       User?                    @relation("EnforcementRevoker", fields: [revokedByAdminUserId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([status, endsAt])
  @@index([createdByAdminUserId, createdAt])
}

model Dispute {
  id                  String                    @id @default(uuid()) @db.Uuid
  openedByUserId      String                    @db.Uuid
  assignedAdminUserId String?                   @db.Uuid
  type                DisputeType
  referenceId         String                    @db.Uuid
  reason              DisputeReason
  details             String
  evidenceSnapshot    Json
  status              DisputeStatus             @default(OPEN)
  resolutionOutcome   DisputeResolutionOutcome?
  resolutionSummary   String?
  resolvedAt          DateTime?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  openedBy            User                      @relation("DisputeOpener", fields: [openedByUserId], references: [id], onDelete: Restrict)
  assignedAdmin       User?                     @relation("DisputeAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, referenceId, createdAt])
  @@index([openedByUserId, createdAt])
  @@index([assignedAdminUserId, status, createdAt])
}

model SupportTicket {
  id                  String                 @id @default(uuid()) @db.Uuid
  referenceCode       String                 @unique
  createdByUserId     String                 @db.Uuid
  assignedAdminUserId String?                @db.Uuid
  subject             String
  category            SupportTicketCategory
  status              SupportTicketStatus    @default(OPEN)
  priority            SupportTicketPriority  @default(NORMAL)
  lastMessageAt       DateTime               @default(now())
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  createdBy           User                   @relation("SupportTicketCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedAdmin       User?                  @relation("SupportTicketAssignee", fields: [assignedAdminUserId], references: [id], onDelete: SetNull)
  messages            SupportTicketMessage[]

  @@index([status, priority, lastMessageAt])
  @@index([createdByUserId, lastMessageAt])
  @@index([assignedAdminUserId, status, lastMessageAt])
}

model SupportTicketMessage {
  id           String                   @id @default(uuid()) @db.Uuid
  ticketId     String                   @db.Uuid
  authorUserId String                   @db.Uuid
  authorRole   SupportMessageAuthorRole
  content      String
  internal     Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  ticket       SupportTicket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User                     @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
}

model TestDataBatch {
  id                   String   @id @default(uuid()) @db.Uuid
  label                String
  createdByAdminUserId String?  @db.Uuid
  createdAt            DateTime @default(now())
  createdByAdmin       User?    @relation("TestDataBatchCreator", fields: [createdByAdminUserId], references: [id], onDelete: SetNull)
  users                User[]

  @@index([createdAt])
}

model ManagedVenue {
  id                    String                    @id @default(uuid()) @db.Uuid
  slug                  String                    @unique
  name                  String
  publicDescription     String?
  addressLine1          String
  addressLine2          String?
  city                  String
  region                String
  postalCode            String?
  countryCode           String
  latitude              Decimal?                  @db.Decimal(9, 6)
  longitude             Decimal?                  @db.Decimal(9, 6)
  timezone              String                    @default("Africa/Johannesburg")
  amenities             String[]                  @default([])
  coverImageUrl         String?
  coverImageAlt         String?
  coverImageAttribution String?
  publicationStatus     VenuePublicationStatus    @default(DRAFT)
  submittedByUserId     String?                   @db.Uuid
  submittedAt           DateTime?
  approvedByUserId      String?                   @db.Uuid
  approvedAt            DateTime?
  deactivatedByUserId   String?                   @db.Uuid
  deactivatedAt         DateTime?
  deactivationReason    String?
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  fields                ManagedField[]
  media                 ManagedVenueMedia[]
  slugAliases           ManagedVenueSlugAlias[]
  cancellationPolicies  VenueCancellationPolicy[]
  beneficiaries         VenueBeneficiary[]
  payables              VenuePayable[]
  settlementBatches     VenueSettlementBatch[]
  submittedBy           User?                     @relation("VenueSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  approvedBy            User?                     @relation("VenueApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  deactivatedBy         User?                     @relation("VenueDeactivator", fields: [deactivatedByUserId], references: [id], onDelete: Restrict)

  @@index([city, publicationStatus, isActive])
}

model ManagedVenueMedia {
  id          String       @id @default(uuid()) @db.Uuid
  venueId     String       @db.Uuid
  url         String
  altText     String
  attribution String
  sortOrder   Int
  createdAt   DateTime     @default(now())
  venue       ManagedVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([venueId, sortOrder])
  @@index([venueId])
}

model ManagedVenueSlugAlias {
  id        String       @id @default(uuid()) @db.Uuid
  venueId   String       @db.Uuid
  slug      String       @unique
  createdAt DateTime     @default(now())
  venue     ManagedVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model VenueCancellationPolicy {
  id                       String             @id @default(uuid()) @db.Uuid
  venueId                  String             @db.Uuid
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  fullCreditBeforeHours    Int                @default(24)
  lateCreditPercent        Int                @default(0)
  venueCancellationPercent Int                @default(100)
  policyText               String
  createdAt                DateTime           @default(now())
  venue                    ManagedVenue       @relation(fields: [venueId], references: [id], onDelete: Restrict)
  reservations             FieldReservation[]

  @@index([venueId, effectiveFrom])
}

model ManagedField {
  id                      String                        @id @default(uuid()) @db.Uuid
  venueId                 String                        @db.Uuid
  name                    String
  description             String?
  status                  ManagedFieldStatus            @default(ACTIVE)
  turnaroundBufferMinutes Int                           @default(15)
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  venue                   ManagedVenue                  @relation(fields: [venueId], references: [id], onDelete: Restrict)
  supportedFormats        ManagedFieldSupportedFormat[]
  availabilityPeriods     ManagedFieldAvailability[]
  exceptions              ManagedFieldException[]
  prices                  ManagedFieldPrice[]
  reservations            FieldReservation[]

  @@unique([venueId, name])
  @@index([venueId, status])
}

model ManagedFieldSupportedFormat {
  fieldId String       @db.Uuid
  format  MatchFormat
  field   ManagedField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([fieldId, format])
}

model ManagedFieldAvailability {
  id          String       @id @default(uuid()) @db.Uuid
  fieldId     String       @db.Uuid
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  createdAt   DateTime     @default(now())
  field       ManagedField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, dayOfWeek])
}

model ManagedFieldException {
  id        String       @id @default(uuid()) @db.Uuid
  fieldId   String       @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  available Boolean      @default(false)
  reason    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  field     ManagedField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([fieldId, startsAt, endsAt])
}

model ManagedFieldPrice {
  id            String             @id @default(uuid()) @db.Uuid
  fieldId       String             @db.Uuid
  amountCents   Int
  currency      String             @default("ZAR")
  format        MatchFormat?
  dayOfWeek     Int?
  startMinute   Int?
  endMinute     Int?
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime           @default(now())
  field         ManagedField       @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  reservations  FieldReservation[]

  @@index([fieldId, effectiveFrom])
}

model PlayerProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String                    @unique @db.Uuid
  displayName        String
  avatarUrl          String?
  bio                String?
  dominantFoot       DominantFoot?
  homeArea           String?
  dateOfBirth        DateTime?                 @db.Date
  yearsExperience    Int?
  cityId             String?                   @db.Uuid
  onboardingStatus   OnboardingStatus          @default(NOT_STARTED)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  city               City?                     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  photo              PlayerPhoto?
  preferredPositions PlayerPreferredPosition[]

  @@index([cityId, onboardingStatus])
}

model PlayerPreferredPosition {
  profileId String           @db.Uuid
  position  FootballPosition
  sortOrder Int
  profile   PlayerProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, position])
  @@unique([profileId, sortOrder])
}

model PlayerPhoto {
  id                String        @id @default(uuid()) @db.Uuid
  profileId         String        @unique @db.Uuid
  fileKey           String        @unique
  mimeType          String
  byteSize          Int
  width             Int
  height            Int
  hiddenAt          DateTime?
  hiddenReason      String?
  moderatedByUserId String?       @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  profile           PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  moderatedBy       User?         @relation("PlayerPhotoModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)

  @@index([hiddenAt])
}

model City {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique
  name            String
  countryCode     String            @default("ZA")
  timezone        String
  supportStatus   CitySupportStatus @default(WAITLIST)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  profiles        PlayerProfile[]
  interestEntries CityInterest[]

  @@index([supportStatus, name])
}

model CityInterest {
  id              String    @id @default(uuid()) @db.Uuid
  cityId          String    @db.Uuid
  userId          String?   @db.Uuid
  email           String
  dedupeKey       String    @unique
  manageTokenHash String    @unique
  consentedAt     DateTime
  source          String
  unsubscribedAt  DateTime?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  city            City      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cityId, consentedAt])
  @@index([userId, createdAt])
}

model LegalDocument {
  id                   String            @id @default(uuid()) @db.Uuid
  type                 LegalDocumentType
  version              String
  title                String
  content              String
  checksum             String
  effectiveAt          DateTime
  material             Boolean           @default(true)
  reacceptanceRequired Boolean           @default(true)
  publishedAt          DateTime?
  createdAt            DateTime          @default(now())
  acceptances          LegalAcceptance[]

  @@unique([type, version])
  @@index([type, publishedAt, effectiveAt])
}

model LegalAcceptance {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  legalDocumentId String        @db.Uuid
  acceptedAt      DateTime      @default(now())
  source          String
  ipHash          String?
  userAgentHash   String?
  evidence        Json
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict)

  @@unique([userId, legalDocumentId])
  @@index([userId, acceptedAt])
}

model VerificationToken {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         String                     @db.Uuid
  purpose        VerificationPurpose
  tokenHash      String                     @unique
  email          String
  targetEmail    String?
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  attemptCount   Int                        @default(0)
  deliveryStatus VerificationDeliveryStatus @default(PENDING)
  deliveryError  String?
  createdAt      DateTime                   @default(now())
  sentAt         DateTime?
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt, usedAt])
}

model WalletAccount {
  id                        String              @id @default(uuid()) @db.Uuid
  userId                    String              @unique @db.Uuid
  currency                  String              @default("ZAR")
  balanceCents              Int                 @default(0)
  /// TKT-606: set by a chargeback reversal; while set the wallet cannot spend (DB allows balance < 0 only then).
  spendingRestrictedAt      DateTime?
  spendingRestrictionReason String?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions              WalletTransaction[]
  holds                     WalletHold[]
}

model WalletTransaction {
  id                String                  @id @default(uuid()) @db.Uuid
  walletAccountId   String                  @db.Uuid
  type              WalletTransactionType
  amountCents       Int
  status            WalletTransactionStatus @default(PENDING)
  provider          String?
  providerReference String?
  idempotencyKey    String                  @unique
  referenceType     String?
  referenceId       String?
  description       String?
  failureReason     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  walletAccount     WalletAccount           @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  matchPayment      MatchPayment?
  providerPayment   ProviderPayment?
  refundDebit       ProviderRefund?         @relation("RefundDebit")
  refundRestore     ProviderRefund?         @relation("RefundRestore")
  disputeDebit      ProviderDispute?        @relation("DisputeDebit")
  disputeReversal   ProviderDispute?        @relation("DisputeReversal")
  teamWalletLink    TeamWalletTransaction?  @relation("TeamWalletPersonalLink")

  @@unique([provider, providerReference])
  @@index([walletAccountId, createdAt])
}

model WalletHold {
  id                    String               @id @default(uuid()) @db.Uuid
  walletAccountId       String               @db.Uuid
  amountCents           Int
  currency              String               @default("ZAR")
  status                WalletHoldStatus     @default(ACTIVE)
  idempotencyKey        String               @unique
  referenceType         String
  referenceId           String
  description           String?
  expiresAt             DateTime?
  capturedAt            DateTime?
  releasedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  walletAccount         WalletAccount        @relation(fields: [walletAccountId], references: [id], onDelete: Restrict)
  fundingContribution   FundingContribution?
  guaranteedReservation FieldReservation?    @relation("ReservationOrganiserGuarantee")

  @@index([walletAccountId, status, expiresAt])
  @@index([referenceType, referenceId, status])
}

/// Gate 6 / TKT-604: one Paystack card top-up. Credited only after our server verifies it.
model ProviderPayment {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @db.Uuid
  walletTransactionId   String                @unique @db.Uuid
  provider              String
  reference             String                @unique
  amountCents           Int
  currency              String                @default("ZAR")
  status                ProviderPaymentStatus @default(INITIALIZED)
  authorizationUrl      String?
  initializeStartedAt   DateTime?
  providerTransactionId String?
  providerStatus        String?
  channel               String?
  lastVerifiedAt        DateTime?
  verifiedAt            DateTime?
  creditedBy            String?
  failureReason         String?
  reviewReason          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletTransaction     WalletTransaction     @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  refunds               ProviderRefund[]
  disputes              ProviderDispute[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// Gate 6 / TKT-606: a refund of a card top-up back to the original card (admin-initiated).
model ProviderRefund {
  id                   String               @id @default(uuid()) @db.Uuid
  providerPaymentId    String               @db.Uuid
  amountCents          Int
  status               ProviderRefundStatus @default(PENDING)
  providerRefundId     String?              @unique
  debitTransactionId   String               @unique @db.Uuid
  restoreTransactionId String?              @unique @db.Uuid
  reason               String
  initiatedByUserId    String               @db.Uuid
  restoredByUserId     String?              @db.Uuid
  restoreReason        String?
  failureReason        String?
  reviewReason         String?
  attempts             Int                  @default(0)
  processedAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  providerPayment      ProviderPayment      @relation(fields: [providerPaymentId], references: [id], onDelete: Restrict)
  debitTransaction     WalletTransaction    @relation("RefundDebit", fields: [debitTransactionId], references: [id], onDelete: Restrict)
  restoreTransaction   WalletTransaction?   @relation("RefundRestore", fields: [restoreTransactionId], references: [id], onDelete: Restrict)
  initiatedBy          User                 @relation("RefundInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  restoredBy           User?                @relation("RefundRestorer", fields: [restoredByUserId], references: [id], onDelete: Restrict)

  @@index([providerPaymentId, status])
  @@index([status, createdAt])
}

/// Gate 6 / TKT-606: a card chargeback against a top-up (reversed on open, restored if we win).
model ProviderDispute {
  id                    String                @id @default(uuid()) @db.Uuid
  providerPaymentId     String                @db.Uuid
  providerDisputeId     String                @unique
  status                ProviderDisputeStatus @default(OPEN)
  amountCents           Int
  debitTransactionId    String                @unique @db.Uuid
  reversalTransactionId String?               @unique @db.Uuid
  resolution            String?
  openedAt              DateTime              @default(now())
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  providerPayment       ProviderPayment       @relation(fields: [providerPaymentId], references: [id], onDelete: Restrict)
  debitTransaction      WalletTransaction     @relation("DisputeDebit", fields: [debitTransactionId], references: [id], onDelete: Restrict)
  reversalTransaction   WalletTransaction?    @relation("DisputeReversal", fields: [reversalTransactionId], references: [id], onDelete: Restrict)

  @@index([providerPaymentId, status])
  @@index([status, openedAt])
}

/// Gate 6 / TKT-607: a venue's bank details (encrypted, admin-only, second-admin approval).
model VenueBeneficiary {
  id               String                 @id @db.Uuid
  venueId          String                 @db.Uuid
  displayName      String
  encryptedDetails String
  keyVersion       Int                    @default(1)
  accountLast4     String
  linkedUserId     String?                @db.Uuid
  status           VenueBeneficiaryStatus @default(PENDING_APPROVAL)
  createdByUserId  String                 @db.Uuid
  approvedByUserId String?                @db.Uuid
  approvedAt       DateTime?
  retiredAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  venue            ManagedVenue           @relation(fields: [venueId], references: [id], onDelete: Restrict)
  linkedUser       User?                  @relation("BeneficiaryLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdBy        User                   @relation("BeneficiaryCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy       User?                  @relation("BeneficiaryApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  settlementBatches VenueSettlementBatch[]

  @@index([venueId, status])
}

/// Gate 6 / TKT-607: what FootyFinder owes a venue for one match that went ahead (admin-only).
model VenuePayable {
  id            String                   @id @default(uuid()) @db.Uuid
  reservationId String                   @unique @db.Uuid
  matchId       String                   @unique @db.Uuid
  venueId       String                   @db.Uuid
  amountCents   Int
  currency      String                   @default("ZAR")
  status        VenuePayableStatus       @default(DUE)
  dueAt         DateTime
  paidAt        DateTime?
  batchId       String?                  @db.Uuid
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  batch         VenueSettlementBatch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  reservation   FieldReservation         @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  match         Match                    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  venue         ManagedVenue             @relation(fields: [venueId], references: [id], onDelete: Restrict)
  adjustments   VenuePayableAdjustment[]

  @@index([venueId, status, dueAt])
  @@index([batchId])
}

/// Gate 6 / TKT-607: a reasoned correction to a payable (applied before or at the next settlement).
model VenuePayableAdjustment {
  id          String       @id @default(uuid()) @db.Uuid
  payableId   String       @db.Uuid
  amountCents Int
  reason      String
  actorUserId    String                @db.Uuid
  appliedBatchId String?               @db.Uuid
  createdAt      DateTime              @default(now())
  payable        VenuePayable          @relation(fields: [payableId], references: [id], onDelete: Restrict)
  actor          User                  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  appliedBatch   VenueSettlementBatch? @relation(fields: [appliedBatchId], references: [id], onDelete: Restrict)

  @@index([payableId, createdAt])
  @@index([appliedBatchId])
}

/// Gate 6 / TKT-608: one venue's weekly manual payout, prepared and approved by different admins.
model VenueSettlementBatch {
  id                String                     @id @default(uuid()) @db.Uuid
  venueId           String                     @db.Uuid
  beneficiaryId     String                     @db.Uuid
  periodStart       DateTime
  periodEnd         DateTime
  payablesCents     Int
  adjustmentsCents  Int
  totalCents        Int
  status            VenueSettlementBatchStatus @default(PREPARED)
  preparedByUserId  String                     @db.Uuid
  preparedAt        DateTime                   @default(now())
  approvedByUserId  String?                    @db.Uuid
  approvedAt        DateTime?
  paidByUserId      String?                    @db.Uuid
  paidAt            DateTime?
  payoutReference   String?                    @unique
  evidenceNote      String?
  cancelledByUserId String?                    @db.Uuid
  cancelledAt       DateTime?
  cancelReason      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  venue             ManagedVenue               @relation(fields: [venueId], references: [id], onDelete: Restrict)
  beneficiary       VenueBeneficiary           @relation(fields: [beneficiaryId], references: [id], onDelete: Restrict)
  preparedBy        User                       @relation("SettlementPreparer", fields: [preparedByUserId], references: [id], onDelete: Restrict)
  approvedBy        User?                      @relation("SettlementApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  paidBy            User?                      @relation("SettlementPayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  cancelledBy       User?                      @relation("SettlementCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  payables          VenuePayable[]
  adjustments       VenuePayableAdjustment[]

  @@index([status, periodStart])
}

/// Gate 6 / TKT-605: every Paystack webhook delivery (bad signatures keep no payload).
model PaymentWebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String
  dedupeKey      String    @unique
  eventType      String?
  reference      String?
  signatureValid Boolean
  payload        Json?
  ipHash         String?
  outcome        String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([reference, receivedAt])
  @@index([signatureValid, receivedAt])
}

model DurableJob {
  id          String           @id @default(uuid()) @db.Uuid
  type        String
  dedupeKey   String           @unique
  payload     Json
  status      DurableJobStatus @default(PENDING)
  runAt       DateTime
  attempts    Int              @default(0)
  maxAttempts Int              @default(10)
  lockedAt    DateTime?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, runAt])
  @@index([type, status, runAt])
}

model Venue {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  addressLine1    String
  addressLine2    String?
  locality        String?
  city            String
  region          String
  postalCode      String?
  countryCode     String
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  externalPlaceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  matches         Match[]
}

model Match {
  id                        String                    @id @default(uuid()) @db.Uuid
  publicSlug                String?                   @unique
  name                      String
  description               String?
  createdById               String                    @db.Uuid
  venueId                   String                    @db.Uuid
  mode                      MatchMode                 @default(QUICK_GAME)
  format                    MatchFormat
  substituteCapacityPerTeam Int                       @default(5)
  rollingSubstitutes        Boolean                   @default(false)
  rules                     MatchRule[]               @default([])
  visibility                MatchVisibility
  inviteToken               String?                   @unique
  inviteTokenHash           String?                   @unique
  startsAt                  DateTime
  durationMinutes           Int
  feeCents                  Int
  currency                  String                    @default("ZAR")
  status                    MatchStatus               @default(OPEN)
  formationVersion          Int                       @default(0)
  goNoGoAt                  DateTime?
  confirmedAt               DateTime?
  cancellationReason        String?
  cancelledAt               DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  createdBy                 User                      @relation("MatchCreator", fields: [createdById], references: [id])
  venue                     Venue                     @relation(fields: [venueId], references: [id])
  participants              MatchParticipant[]
  formationSlots            FormationSlot[]
  messages                  LobbyMessage[]
  result                    MatchResult?
  payments                  MatchPayment[]
  cancellations             ParticipantCancellation[]
  teamSides                 MatchTeam[]
  fieldReservation          FieldReservation?
  formationEvents           MatchFormationEvent[]
  venuePayable              VenuePayable?
  teamWalletHolds           TeamWalletHold[]

  @@index([visibility, startsAt])
  @@index([format, startsAt])
}

model FieldReservation {
  id                              String                   @id @default(uuid()) @db.Uuid
  fieldId                         String                   @db.Uuid
  fieldPriceId                    String                   @db.Uuid
  cancellationPolicyId            String?                  @db.Uuid
  organizerGuaranteeHoldId        String?                  @unique @db.Uuid
  matchId                         String                   @unique @db.Uuid
  source                          FieldReservationSource
  status                          FieldReservationStatus
  startsAt                        DateTime
  endsAt                          DateTime
  fundingDeadline                 DateTime?
  priceCentsSnapshot              Int
  currencySnapshot                String                   @default("ZAR")
  venueNameSnapshot               String
  fieldNameSnapshot               String
  addressSnapshot                 String
  citySnapshot                    String
  timezoneSnapshot                String                   @default("Africa/Johannesburg")
  turnaroundBufferMinutesSnapshot Int                      @default(15)
  cancellationPolicySnapshot      Json?
  organizerGuaranteeCents         Int                      @default(0)
  organizerGuaranteeSettledAt     DateTime?
  playerFeesAppliedCents          Int                      @default(0)
  desiredVisibility               MatchVisibility          @default(PUBLIC)
  confirmedAt                     DateTime?
  cancelledAt                     DateTime?
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @updatedAt
  field                           ManagedField             @relation(fields: [fieldId], references: [id], onDelete: Restrict)
  fieldPrice                      ManagedFieldPrice        @relation(fields: [fieldPriceId], references: [id], onDelete: Restrict)
  cancellationPolicy              VenueCancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id], onDelete: Restrict)
  organizerGuaranteeHold          WalletHold?              @relation("ReservationOrganiserGuarantee", fields: [organizerGuaranteeHoldId], references: [id], onDelete: Restrict)
  match                           Match                    @relation(fields: [matchId], references: [id], onDelete: Restrict)
  obligations                     FundingObligation[]
  venuePayable                    VenuePayable?

  @@index([fieldId, status, startsAt, endsAt])
  @@index([status, fundingDeadline])
}

model FundingObligation {
  id            String                  @id @default(uuid()) @db.Uuid
  reservationId String                  @db.Uuid
  obligationKey String
  requiredCents Int
  status        FundingObligationStatus @default(PENDING)
  capturedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  reservation   FieldReservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  contributions FundingContribution[]

  @@unique([reservationId, obligationKey])
  @@index([reservationId, status])
}

model FundingContribution {
  id             String                    @id @default(uuid()) @db.Uuid
  obligationId   String                    @db.Uuid
  userId         String                    @db.Uuid
  walletHoldId   String                    @unique @db.Uuid
  amountCents    Int
  status         FundingContributionStatus @default(HELD)
  idempotencyKey String                    @unique
  capturedAt     DateTime?
  releasedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  obligation     FundingObligation         @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  user           User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletHold     WalletHold                @relation(fields: [walletHoldId], references: [id], onDelete: Restrict)

  @@index([obligationId, status, createdAt])
  @@index([userId, createdAt])
}

model MatchTeam {
  id                      String                  @id @default(uuid()) @db.Uuid
  matchId                 String                  @db.Uuid
  teamId                  String?                 @db.Uuid
  side                    TeamSide
  organisingUserId        String                  @db.Uuid
  formationKey            String
  teamNameSnapshot        String
  teamImageUrlSnapshot    String?
  primaryColorSnapshot    String?
  secondaryColorSnapshot  String?
  availabilityRequestedAt DateTime?
  lineupFinalizedAt       DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  match                   Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team                    Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  organisingUser          User                    @relation("MatchTeamOrganiser", fields: [organisingUserId], references: [id])
  availabilities          TeamMatchAvailability[]
  selections              TeamMatchSelection[]
  lineupSlots             TeamMatchLineupSlot[]

  @@unique([matchId, side])
  @@unique([matchId, teamId])
  @@index([teamId])
  @@index([organisingUserId])
}

model TeamMatchAvailability {
  id          String                      @id @default(uuid()) @db.Uuid
  matchTeamId String                      @db.Uuid
  userId      String                      @db.Uuid
  status      TeamMatchAvailabilityStatus @default(NO_RESPONSE)
  respondedAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  matchTeam   MatchTeam                   @relation(fields: [matchTeamId], references: [id], onDelete: Cascade)
  user        User                        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([matchTeamId, userId])
  @@index([matchTeamId, status])
  @@index([userId])
}

model TeamMatchSelection {
  id               String                   @id @default(uuid()) @db.Uuid
  matchTeamId      String                   @db.Uuid
  userId           String                   @db.Uuid
  status           TeamMatchSelectionStatus
  selectedByUserId String?                  @db.Uuid
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  matchTeam        MatchTeam                @relation(fields: [matchTeamId], references: [id], onDelete: Cascade)
  user             User                     @relation("TeamMatchSelectedUser", fields: [userId], references: [id], onDelete: Restrict)
  selectedBy       User?                    @relation("TeamMatchSelectionSelector", fields: [selectedByUserId], references: [id], onDelete: SetNull)
  lineupSlot       TeamMatchLineupSlot?

  @@unique([matchTeamId, userId])
  @@index([matchTeamId, status])
  @@index([userId])
  @@index([selectedByUserId])
}

model TeamMatchLineupSlot {
  id          String              @id @default(uuid()) @db.Uuid
  matchTeamId String              @db.Uuid
  slotIndex   Int
  positionX   Decimal             @db.Decimal(5, 2)
  positionY   Decimal             @db.Decimal(5, 2)
  isOpen      Boolean             @default(false)
  selectionId String?             @unique @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  matchTeam   MatchTeam           @relation(fields: [matchTeamId], references: [id], onDelete: Cascade)
  selection   TeamMatchSelection? @relation(fields: [selectionId], references: [id], onDelete: SetNull)

  @@unique([matchTeamId, slotIndex])
  @@index([matchTeamId, isOpen])
}

model MatchParticipant {
  id             String                   @id @default(uuid()) @db.Uuid
  matchId        String                   @db.Uuid
  userId         String                   @db.Uuid
  status         ParticipantStatus        @default(JOINED)
  team           TeamSide
  joinedAt       DateTime                 @default(now())
  leftAt         DateTime?
  match          Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationSlot  FormationSlot?
  payment        MatchPayment?
  scoring        MatchScorer[]
  replacementFor ParticipantCancellation? @relation("ReplacementParticipant")

  @@unique([matchId, userId])
  @@index([matchId, team, status])
  @@index([userId])
}

model FormationSlot {
  id            String            @id @default(uuid()) @db.Uuid
  matchId       String            @db.Uuid
  team          TeamSide
  slotIndex     Int
  positionX     Decimal           @db.Decimal(5, 2)
  positionY     Decimal           @db.Decimal(5, 2)
  participantId String?           @unique @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  match         Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant   MatchParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([matchId, team, slotIndex])
  @@index([matchId, team])
}

model MatchFormationEvent {
  id                    String   @id @default(uuid()) @db.Uuid
  matchId               String   @db.Uuid
  slotId                String   @db.Uuid
  actorUserId           String   @db.Uuid
  action                String
  participantId         String?  @db.Uuid
  previousParticipantId String?  @db.Uuid
  formationVersion      Int
  createdAt             DateTime @default(now())
  match                 Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId, createdAt])
}

model MatchPayment {
  id                  String                   @id @default(uuid()) @db.Uuid
  matchId             String                   @db.Uuid
  userId              String                   @db.Uuid
  participantId       String                   @unique @db.Uuid
  team                TeamSide
  amountCents         Int
  currency            String                   @default("ZAR")
  status              MatchPaymentStatus       @default(SUCCEEDED)
  walletTransactionId String                   @unique @db.Uuid
  idempotencyKey      String                   @unique
  createdAt           DateTime                 @default(now())
  paidAt              DateTime                 @default(now())
  match               Match                    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant         MatchParticipant         @relation(fields: [participantId], references: [id], onDelete: Cascade)
  walletTransaction   WalletTransaction        @relation(fields: [walletTransactionId], references: [id])
  cancellation        ParticipantCancellation?

  @@index([matchId, team, status])
  @@index([userId])
}

model ParticipantCancellation {
  id                       String            @id @default(uuid()) @db.Uuid
  matchId                  String            @db.Uuid
  userId                   String            @db.Uuid
  matchPaymentId           String            @unique @db.Uuid
  originalTeam             TeamSide
  cancelledAt              DateTime          @default(now())
  originalAmountCents      Int
  initialCreditCents       Int
  replacementCreditCents   Int               @default(0)
  replacementParticipantId String?           @unique @db.Uuid
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  match                    Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchPayment             MatchPayment      @relation(fields: [matchPaymentId], references: [id])
  replacementParticipant   MatchParticipant? @relation("ReplacementParticipant", fields: [replacementParticipantId], references: [id])

  @@index([matchId, originalTeam, cancelledAt])
  @@index([userId])
}

model MatchResult {
  id            String                @id @default(uuid()) @db.Uuid
  matchId       String                @unique @db.Uuid
  homeScore     Int
  awayScore     Int
  outcomeType   ResultOutcomeType     @default(PLAYED)
  forfeitWinner TeamSide?
  submittedById String                @db.Uuid
  submittedAt   DateTime              @default(now())
  match         Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  submittedBy   User                  @relation("ResultSubmitter", fields: [submittedById], references: [id])
  scorers       MatchScorer[]
  revisions     MatchResultRevision[]
}

model MatchResultRevision {
  id                   String               @id @default(uuid()) @db.Uuid
  matchResultId        String               @db.Uuid
  revisionNumber       Int
  homeScore            Int
  awayScore            Int
  scorersSnapshot      Json
  reason               ResultRevisionReason
  createdByAdminUserId String?              @db.Uuid
  createdAt            DateTime             @default(now())
  matchResult          MatchResult          @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  createdByAdmin       User?                @relation("ResultRevisionCreator", fields: [createdByAdminUserId], references: [id], onDelete: Restrict)

  @@unique([matchResultId, revisionNumber])
  @@index([matchResultId, createdAt])
  @@index([createdByAdminUserId, createdAt])
}

model MatchScorer {
  id            String           @id @default(uuid()) @db.Uuid
  matchResultId String           @db.Uuid
  participantId String           @db.Uuid
  team          TeamSide
  goals         Int
  matchResult   MatchResult      @relation(fields: [matchResultId], references: [id], onDelete: Cascade)
  participant   MatchParticipant @relation(fields: [participantId], references: [id])

  @@unique([matchResultId, participantId])
}

model LobbyMessage {
  id        String    @id @default(uuid()) @db.Uuid
  matchId   String    @db.Uuid
  senderId  String    @db.Uuid
  content   String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender    User      @relation("LobbyMessageSender", fields: [senderId], references: [id])

  @@index([matchId, createdAt])
}

model Conversation {
  id           String                    @id @default(uuid()) @db.Uuid
  directKey    String                    @unique
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     DirectMessage[]
}

model ConversationParticipant {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model DirectMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  senderId       String       @db.Uuid
  content        String
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("DirectMessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  dedupeKey  String?          @unique
  type       NotificationType
  title      String
  message    String
  targetPath String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Team {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  shortName       String?          @unique
  description     String?
  profileImageUrl String?
  locationText    String?
  primaryFormat   MatchFormat
  primaryColor    String?
  secondaryColor  String?
  ownerUserId     String           @db.Uuid
  /// Gate 7 / D7: a closed team is archived, never deleted, so its money history is kept.
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  owner           User             @relation("TeamOwner", fields: [ownerUserId], references: [id])
  memberships     TeamMembership[]
  invites         TeamInvite[]
  formations      TeamFormation[]
  matchSides      MatchTeam[]
  wallet          TeamWalletAccount?

  @@index([ownerUserId])
  @@index([name])
}

/// Gate 7 / TKT-701 (DEC-014): a team's own wallet, never a subaccount of a personal wallet.
/// balanceCents is the sum of its ledger rows and is only changed by TeamWalletRepository.
model TeamWalletAccount {
  id           String                  @id @default(uuid()) @db.Uuid
  teamId       String                  @unique @db.Uuid
  currency     String                  @default("ZAR")
  balanceCents Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  team         Team                    @relation(fields: [teamId], references: [id], onDelete: Restrict)
  transactions TeamWalletTransaction[]
  holds        TeamWalletHold[]
}

/// Immutable team ledger row (a trigger rejects updates). Signed: credits positive, debits negative.
model TeamWalletTransaction {
  id                        String                    @id @default(uuid()) @db.Uuid
  teamWalletAccountId       String                    @db.Uuid
  type                      TeamWalletTransactionType
  amountCents               Int
  idempotencyKey            String                    @unique
  actorUserId               String?                   @db.Uuid
  contributorUserId         String?                   @db.Uuid
  linkedWalletTransactionId String?                   @unique @db.Uuid
  referenceType             String?
  referenceId               String?
  description               String?
  createdAt                 DateTime                  @default(now())
  account                   TeamWalletAccount         @relation(fields: [teamWalletAccountId], references: [id], onDelete: Restrict)
  actor                     User?                     @relation("TeamWalletActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  contributor               User?                     @relation("TeamWalletContributor", fields: [contributorUserId], references: [id], onDelete: Restrict)
  linkedWalletTransaction   WalletTransaction?        @relation("TeamWalletPersonalLink", fields: [linkedWalletTransactionId], references: [id], onDelete: Restrict)
  spentBy                   TeamWalletAllocation[]    @relation("AllocationContribution")
  spends                    TeamWalletAllocation[]    @relation("AllocationDebit")
  capturedHold              TeamWalletHold?

  @@index([teamWalletAccountId, createdAt])
  @@index([contributorUserId])
}

/// Fill-meter money held for one side of one match (DEC-019 / D2).
model TeamWalletHold {
  id                   String                 @id @default(uuid()) @db.Uuid
  teamWalletAccountId  String                 @db.Uuid
  matchId              String                 @db.Uuid
  side                 TeamSide
  amountCents          Int
  status               TeamWalletHoldStatus   @default(ACTIVE)
  idempotencyKey       String                 @unique
  createdByUserId      String?                @db.Uuid
  captureTransactionId String?                @unique @db.Uuid
  releaseReason        String?
  capturedAt           DateTime?
  releasedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  account              TeamWalletAccount      @relation(fields: [teamWalletAccountId], references: [id], onDelete: Restrict)
  match                Match                  @relation(fields: [matchId], references: [id], onDelete: Restrict)
  createdBy            User?                  @relation("TeamWalletHoldCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  captureTransaction   TeamWalletTransaction? @relation(fields: [captureTransactionId], references: [id], onDelete: Restrict)

  @@index([teamWalletAccountId, status])
  @@index([matchId, side, status])
}

/// Which contribution a team debit spent (oldest first, D8). A trigger stops over-spending one.
model TeamWalletAllocation {
  id                        String                @id @default(uuid()) @db.Uuid
  contributionTransactionId String                @db.Uuid
  debitTransactionId        String                @db.Uuid
  amountCents               Int
  createdAt                 DateTime              @default(now())
  contribution              TeamWalletTransaction @relation("AllocationContribution", fields: [contributionTransactionId], references: [id], onDelete: Restrict)
  debit                     TeamWalletTransaction @relation("AllocationDebit", fields: [debitTransactionId], references: [id], onDelete: Restrict)

  @@unique([contributionTransactionId, debitTransactionId], map: "TeamWalletAllocation_contributionTransactionId_debitTransaction")
  @@index([debitTransactionId])
}

model TeamMembership {
  id             String              @id @default(uuid()) @db.Uuid
  teamId         String              @db.Uuid
  userId         String              @db.Uuid
  role           TeamRole            @default(MEMBER)
  joinedAt       DateTime            @default(now())
  team           Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationSlots TeamFormationSlot[]

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId, role])
}

model TeamInvite {
  id              String    @id @default(uuid()) @db.Uuid
  teamId          String    @db.Uuid
  createdByUserId String    @db.Uuid
  tokenHash       String    @unique
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  maxUses         Int       @default(1)
  useCount        Int       @default(0)
  team            Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("TeamInviteCreator", fields: [createdByUserId], references: [id])

  @@index([teamId, createdAt])
}

model TeamFormation {
  id           String              @id @default(uuid()) @db.Uuid
  teamId       String              @db.Uuid
  format       MatchFormat
  formationKey String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  team         Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slots        TeamFormationSlot[]

  @@unique([teamId, format])
}

model TeamFormationSlot {
  id           String          @id @default(uuid()) @db.Uuid
  formationId  String          @db.Uuid
  slotIndex    Int
  positionX    Decimal         @db.Decimal(5, 2)
  positionY    Decimal         @db.Decimal(5, 2)
  membershipId String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  formation    TeamFormation   @relation(fields: [formationId], references: [id], onDelete: Cascade)
  membership   TeamMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@unique([formationId, slotIndex])
  @@unique([formationId, membershipId])
  @@index([membershipId])
}
