generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MatchStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipantRole {
  HOST
  PLAYER
}

enum ParticipantStatus {
  JOINED
  LEFT
  REMOVED
}

enum TeamSide {
  HOME
  AWAY
}

enum SquadRole {
  STARTER
  RESERVE
}

enum WalletTransactionType {
  DEPOSIT
  MATCH_CREATE
  MATCH_JOIN
}

enum WalletTransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  ERROR
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  username String @unique
  passwordHash String
  firstName String?
  lastName String?
  avatarUrl String?
  balanceCents Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdMatches Match[] @relation("MatchCreator")
  participations MatchParticipant[]
  messages LobbyMessage[] @relation("MessageSender")
  walletTransactions WalletTransaction[]
}

model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  type WalletTransactionType
  amountCents Int
  status WalletTransactionStatus @default(PENDING)
  provider String?
  providerReference String?
  idempotencyKey String @unique
  matchId String? @db.Uuid
  failureReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Match {
  id String @id @default(uuid()) @db.Uuid
  name String
  description String?
  createdById String @db.Uuid
  venueName String
  address String?
  latitude Float?
  longitude Float?
  startsAt DateTime
  maxPlayers Int
  status MatchStatus @default(OPEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy User @relation("MatchCreator", fields: [createdById], references: [id])
  participants MatchParticipant[]
  messages LobbyMessage[]
}

model MatchParticipant {
  id String @id @default(uuid()) @db.Uuid
  matchId String @db.Uuid
  userId String @db.Uuid
  role ParticipantRole @default(PLAYER)
  status ParticipantStatus @default(JOINED)
  team TeamSide?
  squadRole SquadRole?
  slotNumber Int?
  joinedAt DateTime @default(now())
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([matchId, userId])
  @@unique([matchId, team, squadRole, slotNumber])
  @@index([userId])
}

model LobbyMessage {
  id String @id @default(uuid()) @db.Uuid
  matchId String @db.Uuid
  senderId String @db.Uuid
  content String
  createdAt DateTime @default(now())
  editedAt DateTime?
  deletedAt DateTime?
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id])
  @@index([matchId, createdAt])
}
